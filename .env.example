# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Public URL of this site (NOWPayments calls back to SITE_URL/wallet/ipn/ - must be reachable from the internet)
SITE_URL=http://localhost:8000
SUPPORT_EMAIL=support@simcode786.com
SUPPORT_TELEGRAM=

# Supplier account (your PVAPins API key - server side only)
PVAPINS_API_KEY=

# NOWPayments (dashboard -> Store settings -> API key and IPN secret)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=0
